<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hh.apply</string>

  <!-- Запуск раз в час в :00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/yanik/hh-applicant-tool</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yanik/hh-applicant-tool/run-apply-slot.sh</string>
  </array>

  <!-- launchd даёт минимальный PATH — прописываем явно (poetry/docker/ollama/curl) -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/yanik/hh-applicant-tool/logs/apply.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yanik/hh-applicant-tool/logs/apply.log</string>
</dict>
</plist>
