# --- Anthropic ---
# Нужен ТОЛЬКО для капчи (гибрид): основной путь — локальная Gemma (Ollama).
ANTHROPIC_API_KEY=sk-ant-...

# --- Общий прокси: через него ходят И Anthropic-капча, И Telegram-уведомления ---
# Режим (читает run-*.sh):
#   external — Docker не трогаем; берём PROXY_URL как есть (пусто = напрямую).
#   blancvpn — поднимаем sslocal-контейнер и форсим PROXY_URL=socks5://127.0.0.1:1080.
PROXY_MODE=external
# Сейчас: SSH-туннель к зарубежному VPS (autossh, см. launchd com.hh.proxy.plist).
# Формат: socks5://host:port или http://host:port (с логином: scheme://user:pass@host:port).
# hh.ru при этом ходит НАПРЯМУЮ (прокси для него не задаётся).
PROXY_URL=socks5://127.0.0.1:1080

# --- Telegram-уведомления (эскалации + отчёты apply/reply) ---
# Ходят через PROXY_URL (Telegram из РФ может резаться). Бот: @BotFather → токен;
# chat_id: написать боту и открыть https://api.telegram.org/bot<токен>/getUpdates.
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# --- VPN-ключ для sslocal (нужен только при PROXY_MODE=blancvpn) ---
BLANCVPN_OUTLINE_KEY=ss://...
